# Firmware / Compiladores (Binarios y Build)
build/
.pio/
.vscode/.browsedb*
*.o
*.elf
*.bin
*.hex

# Entornos virtuales
.venv/

# Firmware build artifacts
*.o
*.backup
firmware/src/geofence/geofence_test
firmware/src/geofence/geofence_test_debug

# Gentle AI skill registry
.atl/
# Python bytecode caches
__pycache__/
*.pyc

# Altium native libraries and project files (kept out of git, see CLAUDE.md: no EDA binaries)
hardware/altium_project/
hardware/libraries/*/altium_nativo/

# Evidence logs of the engineering report are tracked (raw console captures and test output)
!reports/engineering_report_poc/evidence/logs/*.log

# Raw field-test captures contain the real location of the board: never commit them
reports/engineering_report_poc/evidence/private/

# Host test binaries built by the module Makefiles
firmware/src/*/*_test
firmware/src/*/*_test_san

# Third-party reference material kept local only
docs/references/*.pptx
*:Zone.Identifier
