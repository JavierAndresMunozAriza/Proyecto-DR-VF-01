/*
 * geofence.c
 *
 * Point-in-Polygon algorithm implementation for cattle geofencing collar DR-VF-01
 *
 * This implementation follows the principles from "Making Embedded Systems" by Elecia White:
 * - Defensive programming with comprehensive error checking
 * - Efficient memory usage suitable for embedded systems
 * - Clear, maintainable code structure
 * - Robust handling of edge cases and boundary conditions
 */

#include "geofence.h"
#include <math.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

/* Constants */

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

#define EARTH_RADIUS_METERS 6371000.0
#define DEG_TO_RAD(deg) ((deg) * M_PI / 180.0)
#define RAD_TO_DEG(rad) ((rad) * 180.0 / M_PI)

/* Global state */

static bool g_initialized = false;
static geofence_config_t g_config = {0};

/* Forward declarations of internal functions */
static bool is_valid_coordinate(double lat, double lon);
static double cross_product(const geopoint_t* O, const geopoint_t* A, const geopoint_t* B);

/* Internal utility functions */

/**
 * @brief Validate geographic coordinates
 * Following Elecia White's principle of "Check your assumptions"
 */
/* Public API implementation */

int geofence_init(const geofence_config_t* config) {
    /* Following Elecia White's principle of "Initialize everything explicitly" */
    if (g_initialized) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    if (!config) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    /* Validate configuration parameters */
    if (config->max_polygons == 0 || config->max_vertices_total == 0) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    /* Store configuration */
    g_config = *config;
    g_initialized = true;
    
    return GEOFENCE_SUCCESS;
}

void geofence_deinit(void) {
    /* Following Elecia White's principle of "Clean up after yourself" */
    memset(&g_config, 0, sizeof(g_config));
    g_initialized = false;
}

int geofence_create_polygon(geofence_t* fence, const geopoint_t* vertices, uint16_t num_vertices) {
    if (!g_initialized) {
        return GEOFENCE_ERROR_NOT_INITIALIZED;
    }
    
    if (!fence) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    /* Initialize structure */
    memset(fence, 0, sizeof(geofence_t));
    
    if (num_vertices > 0) {
        if (!vertices) {
            return GEOFENCE_ERROR_INVALID_PARAM;
        }
        
        /* Allocate memory for vertices */
        fence->vertices = (geopoint_t*)malloc(num_vertices * sizeof(geopoint_t));
        if (!fence->vertices) {
            return GEOFENCE_ERROR_OUT_OF_MEMORY;
        }
        
        /* Copy vertices */
        memcpy(fence->vertices, vertices, num_vertices * sizeof(geopoint_t));
        fence->num_vertices = num_vertices;
        fence->capacity = num_vertices;
    }
    
    return GEOFENCE_SUCCESS;
bool geofence_is_point_in_polygon_ray_casting(const geopoint_t* point, const geofence_t* fence) {
    /* Following Elecia White's principle of "Check your assumptions" */
    if (!g_initialized || !point || !fence) {
        return false;
    }
    
    if (fence->num_vertices < 3) {
        return false; /* Not a valid polygon */
    }
    
    /* Validate point coordinates */
    if (!is_valid_coordinate(point->latitude, point->longitude)) {
        return false;
    }
    
    int crossings = 0;
    const uint16_t vertex_count = fence->num_vertices;
    
    for (uint16_t i = 0; i < vertex_count; i++) {
        const geopoint_t* v1 = &fence->vertices[i];
        const geopoint_t* v2 = &fence->vertices[(i + 1) % vertex_count];
        
        /* Check for horizontal line intersection */
        if (((v1->latitude > point->latitude) != (v2->latitude > point->latitude)) &&
            (point->longitude < (v2->longitude - v1->longitude) * 
             (point->latitude - v1->latitude) / (v2->latitude - v1->latitude) + v1->longitude)) {
            crossings++;
        }
    }
    
    /* Odd number of crossings means point is inside */
    return (crossings % 2) == 1;
}


bool geofence_is_point_in_polygon_winding_number(const geopoint_t* point, const geofence_t* fence) {
    if (!g_initialized || !point || !fence) {
        return false;
    }
    
    if (fence->num_vertices < 3) {
        return false; /* Not a valid polygon */
    }
    
    /* Validate point coordinates */
    if (!is_valid_coordinate(point->latitude, point->longitude)) {
        return false;
    }
    
    int winding_number = 0;
    const uint16_t vertex_count = fence->num_vertices;
    
    for (uint16_t i = 0; i < vertex_count; i++) {
        const geopoint_t* v1 = &fence->vertices[i];
        const geopoint_t* v2 = &fence->vertices[(i + 1) % vertex_count];
        
        /* Check if point is on the same horizontal line as the edge */
        if (v1->latitude <= point->latitude) {
            if (v2->latitude > point->latitude) {
                /* Upward crossing */
                if (cross_product(v1, v2, point) > 0) {
                    winding_number++;
                }
            }
        } else {
            if (v2->latitude <= point->latitude) {
                /* Downward crossing */
                if (cross_product(v1, v2, point) < 0) {
                    winding_number--;
                }
            }
double geofence_calculate_distance(const geopoint_t* point1, const geopoint_t* point2) {
    if (!point1 || !point2) {
        return -1.0;
    }
    
    /* Validate coordinates */
    if (!is_valid_coordinate(point1->latitude, point1->longitude) ||
        !is_valid_coordinate(point2->latitude, point2->longitude)) {
        return -1.0;
    }
    
    /* Haversine formula for great-circle distance */
    double lat1_rad = DEG_TO_RAD(point1->latitude);
    double lat2_rad = DEG_TO_RAD(point2->latitude);
    double delta_lat_rad = DEG_TO_RAD(point2->latitude - point1->latitude);
    double delta_lon_rad = DEG_TO_RAD(point2->longitude - point1->longitude);
    
    double a = sin(delta_lat_rad/2) * sin(delta_lat_rad/2) +
               cos(lat1_rad) * cos(lat2_rad) * 
               sin(delta_lon_rad/2) * sin(delta_lon_rad/2);
    double c = 2 * atan2(sqrt(a), sqrt(1-a));
    
    return EARTH_RADIUS_METERS * c;
}

double geofence_get_closest_boundary_point(const geopoint_t* point, const geofence_t* fence, 
                                          geopoint_t* closest_point) {
    if (!g_initialized || !point || !fence || !closest_point) {
        return -1.0;
    }
    
    if (fence->num_vertices < 2) {
        return -1.0;
    }
    
    double min_distance = -1.0;
    geopoint_t best_point = {0};
    
    const uint16_t vertex_count = fence->num_vertices;
    
    /* Check distance to each edge */
    for (uint16_t i = 0; i < vertex_count; i++) {
        const geopoint_t* v1 = &fence->vertices[i];
        const geopoint_t* v2 = &fence->vertices[(i + 1) % vertex_count];
        
        /* For simplicity, we'll calculate distance to endpoints */
        double dist1 = geofence_calculate_distance(point, v1);
        double dist2 = geofence_calculate_distance(point, v2);
        
        if (min_distance < 0 || dist1 < min_distance) {
            min_distance = dist1;
            best_point = *v1;
        }
        
        if (dist2 < min_distance) {
            min_distance = dist2;
            best_point = *v2;
        }
    }
    
    *closest_point = best_point;
    return min_distance;
}

bool geofence_validate_polygon(const geofence_t* fence) {
    if (!fence) {
        return false;
    }
    
    /* Check minimum vertex count */
    if (fence->num_vertices < 3) {
        return false;
    }
    
    /* Validate all coordinates */
    for (uint16_t i = 0; i < fence->num_vertices; i++) {
        if (!is_valid_coordinate(fence->vertices[i].latitude, fence->vertices[i].longitude)) {
            return false;
        }
    }
    
    return true;
}
        }
    }
    
    return winding_number != 0;
}

bool geofence_is_point_in_polygon_optimized(const geopoint_t* point, const geofence_t* fence) {
    /* For this implementation, we'll use the ray casting method as baseline */
    /* In a production system, this would include spatial indexing optimizations */
    return geofence_is_point_in_polygon_ray_casting(point, fence);
}
}

int geofence_add_vertex(geofence_t* fence, const geopoint_t* point) {
    if (!g_initialized || !fence || !point) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    /* Validate coordinates */
    if (!is_valid_coordinate(point->latitude, point->longitude)) {
        return GEOFENCE_ERROR_INVALID_PARAM;
    }
    
    /* Check if we need to allocate more memory */
    if (fence->num_vertices >= fence->capacity) {
        uint16_t new_capacity = (fence->capacity == 0) ? 8 : fence->capacity * 2;
        geopoint_t* new_vertices = (geopoint_t*)realloc(fence->vertices, 
                                                       new_capacity * sizeof(geopoint_t));
        if (!new_vertices) {
            return GEOFENCE_ERROR_OUT_OF_MEMORY;
        }
        
        fence->vertices = new_vertices;
        fence->capacity = new_capacity;
    }
    
    /* Add the new vertex */
    fence->vertices[fence->num_vertices] = *point;
    fence->num_vertices++;
    
    return GEOFENCE_SUCCESS;
}

void geofence_clear_polygon(geofence_t* fence) {
    if (fence) {
        fence->num_vertices = 0;
    }
}

void geofence_destroy_polygon(geofence_t* fence) {
    if (fence) {
        if (fence->vertices) {
            free(fence->vertices);
            fence->vertices = NULL;
        }
        fence->num_vertices = 0;
        fence->capacity = 0;
    }
}
static bool is_valid_coordinate(double lat, double lon) {
    return (lat >= -90.0 && lat <= 90.0 && lon >= -180.0 && lon <= 180.0);
}

/**
 * @brief Calculate cross product of three points for orientation testing
 */
static double cross_product(const geopoint_t* O, const geopoint_t* A, const geopoint_t* B) {
    return (A->longitude - O->longitude) * (B->latitude - O->latitude) - 
           (A->latitude - O->latitude) * (B->longitude - O->longitude);
}

/**
 * @brief Check if point is on the line segment between two points
 */
